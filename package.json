{
  "name": "pidapues-server",
  "version": "1.0.0",
  "private": true,
  "description": "API de PidaPues (Express + MySQL) y servidor de archivos estáticos del frontend.",
  "main": "server.js",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env')) fs.copyFileSync('.env.example', '.env');\"",
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.10.0"
  }
}
